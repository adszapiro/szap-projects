# OpenAI API
OPENAI_API_KEY=sk-proj-xxxxx

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Supabase (use service role key for server-side access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Alpaca Paper Trading
ALPACA_API_KEY=your-paper-api-key
ALPACA_SECRET_KEY=your-paper-secret-key
ALPACA_PAPER=true

# Agent Configuration
AGENT_ENABLED=true
AGENT_MAX_DAILY_TRADES=10
AGENT_MAX_POSITION_PERCENT=20
AGENT_MIN_SHARPE=1.0
AGENT_MAX_DAILY_LOSS_PERCENT=5
