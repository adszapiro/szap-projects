{
  "name": "szap-projects",
  "private": true,
  "description": "Alex Szapiro's project portfolio - a monorepo of web applications",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:portfolio": "npm run dev --workspace=portfolio",
    "dev:todo": "npm run dev --workspace=todo-app",
    "dev:backtester": "npm run dev --workspace=backtester",
    "dev:trading": "npm run dev --workspace=trading-bot",
    "build:all": "turbo run build",
    "deploy": "vercel --prod",
    "deploy:portfolio": "vercel --prod --cwd apps/portfolio",
    "deploy:todo": "vercel --prod --cwd apps/todo-app",
    "deploy:backtester": "vercel --prod --cwd apps/backtester",
    "deploy:trading": "vercel --prod --cwd apps/trading-bot",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "npm install && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.8.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/api-tester",
    "apps/backtester",
    "apps/devpulse",
    "apps/markdown-pro",
    "apps/portfolio",
    "apps/quant-agent",
    "apps/resume-ai",
    "apps/snippet-vault",
    "apps/todo-app",
    "apps/wallet-scope",
    "packages/*"
  ]
}
