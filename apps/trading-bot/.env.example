# Alpaca API Keys (Paper Trading)
# Get your keys at: https://alpaca.markets/
ALPACA_API_KEY=your-paper-api-key
ALPACA_SECRET_KEY=your-paper-secret-key

# Set to 'true' for paper trading (recommended), 'false' for live
ALPACA_PAPER=true

# API Authentication Key (protects trading endpoints)
# Generate a secure random key and set it here
# If not set, API routes are open (development mode only)
TRADING_API_KEY=
